generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model exercise_entries {
  id               Int       @id @default(autoincrement())
  sets             Int
  reps             Int
  weight           Float
  is_personal_best Boolean?  @default(false)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  workout_id       Int
  exercise_id      Int
  exercises        exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_entry_exercise")
  workouts         workouts  @relation(fields: [workout_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_entry_workout")
}

model exercises {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  description      String?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  user_id          Int
  exercise_entries exercise_entries[]
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exercise_user")
}

model users {
  id            Int         @id @default(autoincrement())
  email         String      @unique @db.VarChar(255)
  password_hash String
  full_name     String      @db.VarChar(255)
  avatar_url    String?
  role          String?     @default("user") @db.VarChar(50)
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  exercises     exercises[]
  workouts      workouts[]
}

model workouts {
  id               Int                @id @default(autoincrement())
  title            String             @db.VarChar(255)
  notes            String?
  workout_date     DateTime           @db.Date
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  user_id          Int
  exercise_entries exercise_entries[]
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workout_user")
}
